# Copy to attestation-signer.env (chmod 600). This file holds the ONLY
# secret of the deployment — treat it like a private key, because it is one.

# --- Option A: local WIF backend (generated by `scrollsdk signer init`) ---
ATTESTATION_SIGNER_BACKEND=local
ATTESTATION_SIGNER_WIF=REPLACE_WITH_YOUR_WIF

# --- Option B: AWS KMS backend (create the key in YOUR AWS account) -------
# The container needs AWS credentials (instance role, or static keys below).
# ATTESTATION_SIGNER_BACKEND=aws_kms
# ATTESTATION_SIGNER_KMS_KEY_ID=arn:aws:kms:...
# ATTESTATION_SIGNER_KMS_REGION=us-east-1
# ATTESTATION_SIGNER_KMS_EXPECTED_SIGNER_ID=02...   # compressed pubkey of the KMS key
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Network this signer participates in ----------------------------------
ATTESTATION_SIGNER_NETWORK=testnet

# --- Policy mode (two-phase) ----------------------------------------------
# Pre-genesis the signer cannot satisfy the fail-closed production policy
# (protocol-instance-id etc. only exist AFTER bridge genesis), so it will
# refuse to start in the default production_enforce mode. Run scaffold mode
# until the policy bundle arrives; the bundle's signer-policy.env switches
# this back to production_enforce.
ATTESTATION_SIGNER_POLICY_MODE=staging_scaffold

# TSO callback target. A placeholder is fine before you receive the policy
# bundle — the bundle's signer-policy.env overrides it with the real URL.
ATTESTATION_SIGNER_TSO_URL=http://tso-not-yet-configured.invalid
