# Copy to attestation-signer.env (chmod 600). This file can hold the signing
# key; protect it and the separate transport.key as deployment secrets.

# --- Option A: local WIF backend (generated by `scrollsdk signer init`) ---
ATTESTATION_SIGNER_BACKEND=local
ATTESTATION_SIGNER_WIF=REPLACE_WITH_YOUR_WIF

# --- Option B: AWS KMS backend (create the key in YOUR AWS account) -------
# The container needs AWS credentials (instance role, or static keys below).
# ATTESTATION_SIGNER_BACKEND=aws_kms
# ATTESTATION_SIGNER_KMS_KEY_ID=arn:aws:kms:...
# ATTESTATION_SIGNER_KMS_REGION=us-east-1
# ATTESTATION_SIGNER_KMS_EXPECTED_SIGNER_ID=02...   # compressed pubkey of the KMS key
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Network this signer participates in ----------------------------------
ATTESTATION_SIGNER_NETWORK=testnet

# --- TSO transport (dial-out) ---------------------------------------------
# The signer polls the TSO and signs every request with a separate transport
# key: ./transport.key (32-byte hex, mode 0600), mounted by docker-compose.yml.
# Generate it once: (umask 077 && openssl rand -hex 32 > transport.key)
ATTESTATION_SIGNER_TSO_TRANSPORT_KEY_FILE=/etc/dogeos-partner/transport.key
ATTESTATION_SIGNER_TSO_DELIVERY=pull

# --- Policy enforcement ---------------------------------------------------
# Beta.6 uses enforce by default. Observe requires a testnet-observe build
# and is testnet-only; mainnet requires enforce. Neither mode bypasses the
# canonical protocol-context requirement:
# create the descriptor before genesis, then start after receiving the bundle.
# The generated signer-policy.env selects the bridge's reviewed runtime mode.
ATTESTATION_SIGNER_POLICY_MODE=enforce

# Externally-supplied policy values (e.g. TSO_URL, protocol instance, bridge
# namespace) are NOT set here. They come from the bridge operator's
# signer-policy.env after genesis; see docker-compose.yml env_file order.

# --- Approved beta.6 binary identity (not proof-program/CubeSigner pins) ---
# Update these together with the selected image. The image tag is selected by
# Docker Compose; env_file alone does not supply Compose interpolation values.
ATTESTATION_SIGNER_ALLOWED_RELEASE_VERSION=0.3.0
ATTESTATION_SIGNER_ALLOWED_GIT_COMMIT=56007d3c413ad07f33d0e08b272004089c911f78
