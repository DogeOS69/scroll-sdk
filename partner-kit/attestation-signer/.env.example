# Compose identity: preserve for restarts; choose a NEW name for a NEW signer.
COMPOSE_PROJECT_NAME=REPLACE_WITH_SIGNER_NAME
# Approved beta.7 release. Review all four fields together for another release.
SIGNER_IMAGE=dogeos69/attestation-signer@sha256:7727d3c8dbf2f59f6e48993d1a6885707d4dadfe177cbaf9e3c2ee9986e2d7a0
SIGNER_RELEASE_VERSION=0.3.0
SIGNER_GIT_COMMIT=50653e7b67e2a6a8eadef06fabdec8037e6f61ef
SIGNER_POLICY_VERSION=1
# Dynamic loopback ports allow old/new signers on one host.
SIGNER_HTTP_PORT=0
SIGNER_METRICS_PORT=0
