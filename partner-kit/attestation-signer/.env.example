# Compose identity: preserve for restarts; choose a NEW name for a NEW signer.
COMPOSE_PROJECT_NAME=REPLACE_WITH_SIGNER_NAME
# Approved beta.6a release. Review all four fields together for another release.
SIGNER_IMAGE=dogeos69/attestation-signer@sha256:b69b503511837cfa80eb427b41fcefc5e47dbc8f2cfece5a04437ef83653359b
SIGNER_RELEASE_VERSION=0.3.0
SIGNER_GIT_COMMIT=20746174e993a64e7edb132b9ecdbd989788d864
SIGNER_POLICY_VERSION=1
# Dynamic loopback ports allow old/new signers on one host.
SIGNER_HTTP_PORT=0
SIGNER_METRICS_PORT=0
