# Compose identity: preserve for restarts; choose a NEW name for a NEW signer.
COMPOSE_PROJECT_NAME=REPLACE_WITH_SIGNER_NAME
# Approved beta.8 release. Review all four fields together for another release.
SIGNER_IMAGE=dogeos69/attestation-signer@sha256:0795b7d7a0fcec5a85170147753cae6c2ba7c5217b68289360cd8e249553a8e5
SIGNER_RELEASE_VERSION=0.3.0
SIGNER_GIT_COMMIT=a0bc76bbdc85e1600c257768c417f2ea14981957
SIGNER_POLICY_VERSION=1
# Dynamic loopback ports allow old/new signers on one host.
SIGNER_HTTP_PORT=0
SIGNER_METRICS_PORT=0
