# PRIVATE when populated. Optional for local keys or an instance IAM role.
# Supply a dedicated signer profile in ./aws/config and ./aws/credentials,
# OR temporary session credentials below. Do not commit or share this file.
# AWS_PROFILE=signer
# AWS_ACCESS_KEY_ID=REPLACE_WITH_TEMPORARY_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_TEMPORARY_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=REPLACE_WITH_TEMPORARY_SESSION_TOKEN
