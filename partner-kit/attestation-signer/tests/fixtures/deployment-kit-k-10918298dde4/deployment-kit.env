# dogeos-core attestation_evidence_v2 policy for active/real/enforce.
ATTESTATION_SIGNER_POLICY_MODE=enforce
ATTESTATION_SIGNER_NETWORK=testnet
ATTESTATION_SIGNER_PROTOCOL_CONTEXT_JSON=/etc/dogeos/protocol_context.json
ATTESTATION_SIGNER_ARTIFACT_ALLOWED_ORIGINS=https://s3.us-east-1.amazonaws.com
ATTESTATION_SIGNER_ADVANCE_L2_AGG_VERIFYING_KEY_PATH=/etc/dogeos/advance-l2-agg-verifying-key.bin
ATTESTATION_SIGNER_ADVANCE_L2_BATCH_PROGRAM_COMMITMENT_HEX=0x22222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222
ATTESTATION_SIGNER_L2_RANGE_AGGREGATION_PROGRAM_COMMITMENT_HEX=0x33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
ATTESTATION_SIGNER_TSO_URL=https://tso.example.com
