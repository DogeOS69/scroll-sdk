# Configuration generation and validation belong to `scrollsdk setup ...`.
# prep-charts emits self-contained proof values; this Makefile only runs
# ordinary Helm installs/removals. Run prep-charts and proof-config-check first.

NAMESPACE ?= default
# Kubernetes context name from `kubectl config get-contexts`.
# Applies to every Helm/Kubectl cluster operation, including recursive targets.
# Empty uses the current kubeconfig context; no global context is changed.
# Example: make install-dogecoin KUBE_CONTEXT=regtest-cluster NAMESPACE=default
KUBE_CONTEXT ?=
# Must match dstackController.monitoring.namespace and the published Secrets.
DSTACK_NAMESPACE ?= dstack-system
DSTACK_CONTROLLER_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/dstack-controller
DSTACK_CONTROLLER_CHART_VERSION ?= 0.1.2
DSTACK_CONTROLLER_VALUES ?= values/dstack-controller-production.yaml
# prep-charts emits this overlay separately from the base monitor values.
# Keep applying it on subsequent monitor upgrades, including install-all.
SCROLL_MONITOR_DSTACK_VALUES ?= $(wildcard values/scroll-monitor-dstack.yaml)
SCROLL_MONITOR_DSTACK_ARGS = $(if $(strip $(SCROLL_MONITOR_DSTACK_VALUES)),--values "$(SCROLL_MONITOR_DSTACK_VALUES)")
EAGER_MATERIALIZER_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/eager-materializer
EAGER_MATERIALIZER_CHART_VERSION ?= 0.1.1
ETH_DA_SUBMITTER_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/eth-da-submitter
ETH_DA_SUBMITTER_CHART_VERSION ?= 0.1.3
PROOF_COORDINATOR_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/proof-coordinator
PROOF_COORDINATOR_CHART_VERSION ?= 0.3.3
PROVER_WORKER_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/prover-worker
PROVER_WORKER_CHART_VERSION ?= 0.1.0
WITHDRAWAL_PROCESSOR_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/withdrawal-processor
WITHDRAWAL_PROCESSOR_CHART_VERSION ?= 0.1.24
CURL_IMAGE ?= curlimages/curl:8.20.0
L2_RETH_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/l2-reth
L2_RETH_CHART_VERSION ?= 0.1.5
# Existing-chain upgrade hook only. Fresh native Reth genesis needs neither
# file, and this repository does not ship a deployment-specific normalizer.
# To perform a reviewed migration, supply BOTH paths explicitly.
L2_RETH_GENESIS_NORMALIZER_VALUES ?=
L2_RETH_GENESIS_NORMALIZER_SCRIPT ?=
INSTALL_ALL_REQUIRED_VALUES = \
	values/scroll-monitor-production.yaml \
	values/genesis.yaml \
	values/protocol_context.yaml \
	values/l1-interface-production.yaml \
	values/metrics-exporter-production.yaml \
	values/l2-reth-sequencer-production-0.yaml \
	values/l2-reth-sequencer-production-1.yaml \
	values/l2-reth-bootnode-production-0.yaml \
	values/l2-reth-bootnode-production-1.yaml \
	values/l2-reth-rpc-production.yaml \
	values/contracts-production.yaml \
	values/scroll-common-config-contracts.yaml \
	values/scroll-common-config.yaml \
	values/eth-da-submitter-production.yaml \
	values/fee-oracle-production.yaml \
	values/cubesigner-signer-production.yaml \
	values/tso-service-production.yaml \
	values/withdrawal-processor-production.yaml \
	values/proof-coordinator-production.yaml \
	values/prover-worker-production.yaml \
	withdrawal-processor/WithdrawalProcessor.toml \
	proof-coordinator/ProofCoordinator.toml \
	values/blockscout-production.yaml \
	values/frontends-production.yaml \
	values/frontends-config.yaml \
	values/testnet-activity-helper-production.yaml
L2_RETH_GENESIS_NORMALIZER_ARGS =
ifneq ($(strip $(L2_RETH_GENESIS_NORMALIZER_VALUES)$(L2_RETH_GENESIS_NORMALIZER_SCRIPT)),)
ifeq ($(strip $(L2_RETH_GENESIS_NORMALIZER_VALUES)),)
$(error Supply L2_RETH_GENESIS_NORMALIZER_VALUES together with L2_RETH_GENESIS_NORMALIZER_SCRIPT)
endif
ifeq ($(strip $(L2_RETH_GENESIS_NORMALIZER_SCRIPT)),)
$(error Supply L2_RETH_GENESIS_NORMALIZER_SCRIPT together with L2_RETH_GENESIS_NORMALIZER_VALUES)
endif
L2_RETH_GENESIS_NORMALIZER_ARGS = --values $(L2_RETH_GENESIS_NORMALIZER_VALUES) \
	--set-file configMaps.reth-genesis-normalizer.data.normalize-reth-genesis=$(L2_RETH_GENESIS_NORMALIZER_SCRIPT)
INSTALL_ALL_REQUIRED_VALUES += $(L2_RETH_GENESIS_NORMALIZER_VALUES) $(L2_RETH_GENESIS_NORMALIZER_SCRIPT)
endif

.PHONY: prepare install-dogecoin install-scroll-core \
	install-dstack-controller install-scroll-monitor \
	install-contracts install-eth-da-submitter \
	install-l2-reth-sequencer install-l2-reth-rpc \
	install-l2-reth-bootnode \
	check-install-all-values \
	install-fee-oracle \
	install-cubesigner-signer install-tso install-withdrawal-processor install-proof-coordinator install-prover-worker reconcile-proof-services \
	install-blockscout install-frontends install-testnet-activity-helper install-all \
	delete-all delete-dogecoin delete-frontends \
	delete-blockscout delete-withdrawal-processor delete-proof-coordinator delete-prover-worker delete-tso \
	delete-eth-da-submitter delete-fee-oracle delete-cubesigner-signer \
	delete-testnet-activity-helper \
	delete-l2-reth delete-l2-reth-rpc delete-l2-reth-sequencer delete-l2-reth-bootnode

prepare:
	helm repo add grafana https://grafana.github.io/helm-charts
	helm repo update

install-dogecoin:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i dogecoin-testnet oci://ghcr.io/dogeos69/scroll-sdk/helm/dogecoin -n "$(NAMESPACE)" \
		--version=0.1.13 \
		--values values/dogecoin-production.yaml

install-blockbook:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i blockbook-testnet oci://ghcr.io/dogeos69/scroll-sdk/helm/blockbook -n "$(NAMESPACE)" \
		--version=0.1.4 \
		--values values/blockbook-production.yaml

install-l1-interface:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l1-interface oci://ghcr.io/dogeos69/scroll-sdk/helm/l1-interface -n "$(NAMESPACE)" \
		--version=0.0.22 \
		--values values/l1-interface-production.yaml

install-l1-devnet:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l1-devnet oci://ghcr.io/dogeos69/scroll-sdk/helm/l1-devnet -n "$(NAMESPACE)" \
		--wait  \
		--version=0.1.6-dogeos \
		--values values/l1-devnet-production.yaml

install-scroll-monitor:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i scroll-monitor oci://ghcr.io/dogeos69/scroll-sdk/helm/scroll-monitor -n "$(NAMESPACE)" \
		--version=0.1.43-dogeos \
		--values values/scroll-monitor-production.yaml $(SCROLL_MONITOR_DSTACK_ARGS)

# Independent release: prepare/publish dstack Secrets and install the monitor's
# Prometheus Operator CRDs first. See dstack-monitoring/README.md.
install-dstack-controller:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i dstack-controller $(DSTACK_CONTROLLER_CHART) -n "$(DSTACK_NAMESPACE)" \
		--create-namespace \
		--version $(DSTACK_CONTROLLER_CHART_VERSION) \
		--values "$(DSTACK_CONTROLLER_VALUES)"

install-scroll-common:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i scroll-common oci://ghcr.io/dogeos69/scroll-sdk/helm/scroll-common -n "$(NAMESPACE)" \
		--version=0.3.2-dogeos \
		--values values/genesis.yaml \
		--values values/protocol_context.yaml

install-scroll-core:
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-scroll-monitor
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-scroll-common
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-l1-interface

	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i metrics-exporter oci://ghcr.io/dogeos69/scroll-sdk/helm/metrics-exporter -n "$(NAMESPACE)" \
		--version=0.1.9 \
		--values values/metrics-exporter-production.yaml

	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-l2-reth-sequencer
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-l2-reth-bootnode
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-l2-reth-rpc

install-l2-reth-sequencer:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l2-reth-sequencer-0 $(L2_RETH_CHART) -n "$(NAMESPACE)" \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-sequencer-production-0.yaml $(L2_RETH_GENESIS_NORMALIZER_ARGS)

	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l2-reth-sequencer-1 $(L2_RETH_CHART) -n "$(NAMESPACE)" \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-sequencer-production-1.yaml $(L2_RETH_GENESIS_NORMALIZER_ARGS)


install-l2-reth-rpc:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l2-reth-rpc $(L2_RETH_CHART) -n "$(NAMESPACE)" \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-rpc-production.yaml $(L2_RETH_GENESIS_NORMALIZER_ARGS)

	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l2-reth-rpc-public $(L2_RETH_CHART) -n "$(NAMESPACE)" \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-rpc-public-production.yaml $(L2_RETH_GENESIS_NORMALIZER_ARGS)

install-l2-reth-bootnode:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l2-reth-bootnode-0 $(L2_RETH_CHART) -n "$(NAMESPACE)" \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-bootnode-production-0.yaml $(L2_RETH_GENESIS_NORMALIZER_ARGS)

	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i l2-reth-bootnode-1 $(L2_RETH_CHART) -n "$(NAMESPACE)" \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-bootnode-production-1.yaml $(L2_RETH_GENESIS_NORMALIZER_ARGS)

install-contracts:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i contracts oci://ghcr.io/dogeos69/scroll-sdk/helm/contracts -n "$(NAMESPACE)" \
		--version=0.1.23 \
		--values values/contracts-production.yaml \
		--values values/scroll-common-config-contracts.yaml \
		--values values/scroll-common-config.yaml
	kubectl --context "$(KUBE_CONTEXT)" wait --for=jsonpath='{.status.phase}'=Succeeded --timeout=600s pod -l app.kubernetes.io/instance=contracts -n "$(NAMESPACE)"

install-eth-da-submitter:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i eth-da-submitter $(ETH_DA_SUBMITTER_CHART) -n "$(NAMESPACE)" \
		--version=$(ETH_DA_SUBMITTER_CHART_VERSION) \
		--values values/eth-da-submitter-production.yaml \
		--wait

install-fee-oracle:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i fee-oracle oci://ghcr.io/dogeos69/scroll-sdk/helm/fee-oracle -n "$(NAMESPACE)" \
		--version=0.0.10 \
		--values values/fee-oracle-production.yaml

install-cubesigner-signer:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i cubesigner-signer oci://ghcr.io/dogeos69/scroll-sdk/helm/cubesigner-signer -n "$(NAMESPACE)" \
		--version=0.1.9 \
		--values values/cubesigner-signer-production.yaml

install-tso:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i tso-service oci://ghcr.io/dogeos69/scroll-sdk/helm/tso-service -n "$(NAMESPACE)" \
		--version=0.1.10 \
		--values values/tso-service-production.yaml \
		--wait

install-withdrawal-processor:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i withdrawal-processor $(WITHDRAWAL_PROCESSOR_CHART) -n "$(NAMESPACE)" \
		--version $(WITHDRAWAL_PROCESSOR_CHART_VERSION) \
		--values values/withdrawal-processor-production.yaml

install-proof-coordinator:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i proof-coordinator $(PROOF_COORDINATOR_CHART) -n "$(NAMESPACE)" \
		--version $(PROOF_COORDINATOR_CHART_VERSION) \
		--values values/proof-coordinator-production.yaml

install-prover-worker:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i prover-worker $(PROVER_WORKER_CHART) -n "$(NAMESPACE)" \
		--version $(PROVER_WORKER_CHART_VERSION) \
		--values values/prover-worker-production.yaml

.PHONY: install-eager-materializer
# Invoke after prep-charts has emitted an enabled producer contract.
install-eager-materializer:
	test -n "$(KUBE_CONTEXT)"
	test "$$(jq -r '.components.eagerMaterializer.enabled // false' .data/proof-deployment.json)" = true
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i eager-materializer $(EAGER_MATERIALIZER_CHART) -n "$(NAMESPACE)" \
		--version $(EAGER_MATERIALIZER_CHART_VERSION) \
		--values values/eager-materializer-production.yaml

# Proof Coordinator remains deployed while the generated contract selects its
# idle or active config. The contract decides whether the local prover-worker
# runs; production/external keeps it absent and emits a verified GPU-host bundle.
reconcile-proof-services:
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-eth-da-submitter
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-withdrawal-processor
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-tso
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-proof-coordinator
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-prover-worker

install-blockscout:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i blockscout oci://ghcr.io/dogeos69/scroll-sdk/helm/blockscout -n "$(NAMESPACE)" \
		--version=0.1.9-dogeos \
		--values values/blockscout-production.yaml

	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i blockscout-sc-verifier oci://ghcr.io/dogeos69/scroll-sdk/helm/blockscout-sc-verifier -n "$(NAMESPACE)" \
		--version=0.1.6-dogeos

install-frontends:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i frontends oci://ghcr.io/dogeos69/scroll-sdk/helm/frontends -n "$(NAMESPACE)" \
		--version=0.1.2-dogeos \
		--values values/frontends-production.yaml \
		--values values/frontends-config.yaml


install-testnet-activity-helper:
	helm --kube-context "$(KUBE_CONTEXT)" upgrade -i testnet-activity-helper oci://ghcr.io/dogeos69/scroll-sdk/helm/testnet-activity-helper -n "$(NAMESPACE)" \
		--version=0.1.2 \
		--values values/testnet-activity-helper-production.yaml

start-l1-sync:
	kubectl --context "$(KUBE_CONTEXT)" run "start-l1-sync-$$(date +%s)" \
		-n "$(NAMESPACE)" \
		--image=$(CURL_IMAGE) \
		--restart=Never \
		--rm \
		-i \
		--quiet \
		--command -- \
		curl -fsS -X POST http://l1-interface:9091/disable-genesis-hold

check-install-all-values:
	@set -eu; \
	missing=""; \
	for file in $(INSTALL_ALL_REQUIRED_VALUES); do \
		if [ ! -f "$$file" ]; then missing="$$missing\n  - $$file"; fi; \
	done; \
	if [ -n "$$missing" ]; then \
		printf 'install-all requires values files that are currently missing:%b\n' "$$missing" >&2; \
		exit 1; \
	fi

install-all: check-install-all-values
	kubectl --context "$(KUBE_CONTEXT)" wait --for=condition=Ready --timeout=600s pod -l app.kubernetes.io/instance=dogecoin-testnet -n "$(NAMESPACE)" && scrollsdk setup dogecoin-wallet-import
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-scroll-core
	kubectl --context "$(KUBE_CONTEXT)" wait --for=condition=Ready --timeout=600s pod -l app.kubernetes.io/instance=l1-interface -n "$(NAMESPACE)"
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-contracts
	scrollsdk helper fund-accounts -l 2 -f 0.2 -d
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-eth-da-submitter
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-fee-oracle
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-cubesigner-signer
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) reconcile-proof-services
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-blockscout
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-frontends
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) install-testnet-activity-helper
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) start-l1-sync

delete-all:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" scroll-common || true
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) delete-l2-reth || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" frontends || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" fee-oracle || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" contracts || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" scroll-monitor || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" metrics-exporter || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" blockscout || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" blockscout-sc-verifier || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" withdrawal-processor || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" proof-coordinator || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" prover-worker || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" tso-service || true
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) delete-cubesigner-signer || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" eth-da-submitter || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l1-interface || true
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) delete-testnet-activity-helper || true

delete-l1-interface:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l1-interface

delete-l1-devnet:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l1-devnet

delete-dogecoin:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" dogecoin-testnet

delete-blockbook:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" blockbook-testnet

delete-frontends:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" frontends

delete-blockscout:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" blockscout || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" blockscout-sc-verifier || true

delete-withdrawal-processor:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" withdrawal-processor

delete-proof-coordinator:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" proof-coordinator

delete-prover-worker:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" prover-worker

delete-tso:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" tso-service

delete-eth-da-submitter:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" eth-da-submitter

delete-fee-oracle:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" fee-oracle

delete-cubesigner-signer:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" cubesigner-signer || true

delete-testnet-activity-helper:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" testnet-activity-helper

delete-l2-reth-rpc:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l2-reth-rpc

delete-l2-reth:
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) delete-l2-reth-rpc || true
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) delete-l2-reth-sequencer || true
	$(MAKE) -f $(firstword $(MAKEFILE_LIST)) delete-l2-reth-bootnode || true

delete-l2-reth-sequencer:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l2-reth-sequencer-0 || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l2-reth-sequencer-1 || true
	kubectl --context "$(KUBE_CONTEXT)" delete pvc -n "$(NAMESPACE)" l2-reth-sequencer-0-data || true
	kubectl --context "$(KUBE_CONTEXT)" delete pvc -n "$(NAMESPACE)" l2-reth-sequencer-1-data || true

delete-l2-reth-bootnode:
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l2-reth-bootnode-0 || true
	kubectl --context "$(KUBE_CONTEXT)" delete pvc -n "$(NAMESPACE)" l2-reth-bootnode-0-data || true
	helm --kube-context "$(KUBE_CONTEXT)" delete -n "$(NAMESPACE)" l2-reth-bootnode-1 || true
	kubectl --context "$(KUBE_CONTEXT)" delete pvc -n "$(NAMESPACE)" l2-reth-bootnode-1-data || true
