NAMESPACE ?= default
PROOF_COORDINATOR_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/proof-coordinator
PROOF_COORDINATOR_CHART_VERSION ?= 0.3.0
PROOF_COORDINATOR_CONFIG ?= proof-coordinator/ProofCoordinator.toml
WITHDRAWAL_PROCESSOR_CONFIG ?= withdrawal-processor/WithdrawalProcessor.toml
PROOF_STATEMENT_NAMESPACE_CONFIG ?= proof-artifacts/manifests/statement-namespace.json
# One switch selects release-artifact proving or the e2e_harness-compatible
# deterministic mock lane. Values: production | mock.
PROVING_MODE ?= production
# Stable credential-free public GET root for proof objects. The external worker
# reads inputs and partner signers read accepted proofs below the same root.
PROOF_ARTIFACT_BASE_URL ?=
# AWS provisioning inputs for `make proof-aws-init` (S3 bucket, IRSA roles,
# bearer-token secret). All three are required by that target.
AWS_REGION ?=
EKS_CLUSTER ?=
NETWORK_ALIAS ?=
PROOF_AWS_INIT_FLAGS ?=
# Extra scrollsdk setup proof-config flags, e.g.:
#   --enable-withdrawal-proof      flip withdrawalProof.enabled after staging
PROOF_CONFIG_FLAGS ?=
ifeq ($(PROVING_MODE),mock)
PROOF_CONFIG_INPUTS =
PROOF_CHUNK_MANIFEST ?= proof-artifacts/mock-manifests/scroll-chunk-topology-program.json
PROOF_BATCH_MANIFEST ?= proof-artifacts/mock-manifests/scroll-batch-topology-program.json
PROOF_BRIDGE_MANIFEST ?= proof-artifacts/mock-manifests/bridge-topology-program.json
PROOF_CHUNK_MANIFEST_KEY := scroll-chunk-topology-program\.json
PROOF_BATCH_MANIFEST_KEY := scroll-batch-topology-program\.json
PROOF_BRIDGE_MANIFEST_KEY := bridge-topology-program\.json
else
PROOF_CONFIG_INPUTS = \
	proof-artifacts/release.json \
	proof-artifacts/manifests/scroll-chunk.json \
	proof-artifacts/manifests/scroll-batch.json \
	proof-artifacts/manifests/bridge-transition.json
PROOF_CHUNK_MANIFEST ?= proof-artifacts/manifests/scroll-chunk.json
PROOF_BATCH_MANIFEST ?= proof-artifacts/manifests/scroll-batch.json
PROOF_BRIDGE_MANIFEST ?= proof-artifacts/manifests/bridge-transition.json
PROOF_CHUNK_MANIFEST_KEY := scroll-chunk\.json
PROOF_BATCH_MANIFEST_KEY := scroll-batch\.json
PROOF_BRIDGE_MANIFEST_KEY := bridge-transition\.json
endif
WITHDRAWAL_PROOF_INSTALL_INPUTS = \
	$(WITHDRAWAL_PROCESSOR_CONFIG) \
	$(PROOF_CHUNK_MANIFEST) \
	$(PROOF_BATCH_MANIFEST) \
	$(PROOF_BRIDGE_MANIFEST)
PROOF_COORDINATOR_INSTALL_INPUTS = \
	$(PROOF_COORDINATOR_CONFIG) \
	$(PROOF_CHUNK_MANIFEST) \
	$(PROOF_BATCH_MANIFEST) \
	$(PROOF_BRIDGE_MANIFEST) \
	$(PROOF_STATEMENT_NAMESPACE_CONFIG)
CURL_IMAGE ?= curlimages/curl:8.20.0
L2_RETH_CHART ?= oci://ghcr.io/dogeos69/scroll-sdk/helm/l2-reth
L2_RETH_CHART_VERSION ?= 0.1.2
L2_RETH_GENESIS_NORMALIZER_VALUES ?= values/l2-reth-genesis-normalizer.yaml
L2_RETH_GENESIS_NORMALIZER_SCRIPT ?= scripts/upgrade/normalize-reth-genesis.sh
INSTALL_ALL_REQUIRED_VALUES = \
	values/scroll-monitor-production.yaml \
	values/genesis.yaml \
	values/protocol_context.yaml \
	values/l1-interface-production.yaml \
	values/metrics-exporter-production.yaml \
	values/l2-reth-sequencer-production-0.yaml \
	values/l2-reth-sequencer-production-1.yaml \
	values/l2-reth-bootnode-production-0.yaml \
	values/l2-reth-bootnode-production-1.yaml \
	values/l2-reth-rpc-production.yaml \
	values/l2-reth-genesis-normalizer.yaml \
	values/contracts-production.yaml \
	values/scroll-common-config-contracts.yaml \
	values/scroll-common-config.yaml \
	values/eth-da-submitter-production.yaml \
	values/fee-oracle-production.yaml \
	values/cubesigner-signer-production-0.yaml \
	values/tso-service-production.yaml \
	values/withdrawal-processor-production.yaml \
	$(WITHDRAWAL_PROCESSOR_CONFIG) \
	values/proof-coordinator-production.yaml \
	values/blockscout-production.yaml \
	values/frontends-production.yaml \
	values/frontends-config.yaml \
	values/testnet-activity-helper-production.yaml
L2_RETH_GENESIS_NORMALIZER_ARGS = --values $(L2_RETH_GENESIS_NORMALIZER_VALUES) \
	--set-file configMaps.reth-genesis-normalizer.data.normalize-reth-genesis=$(L2_RETH_GENESIS_NORMALIZER_SCRIPT)

.PHONY: prepare proof-aws-init proof-config check-proof-config-inputs \
	check-withdrawal-proof-install-inputs check-proof-coordinator-install-inputs \
	install-dogecoin install-celestia install-scroll-core \
	install-contracts install-eth-da-submitter \
	install-l2-reth-sequencer install-l2-reth-rpc \
	install-l2-reth-bootnode \
	check-install-all-values \
	install-fee-oracle \
	install-cubesigner-signers install-tso install-withdrawal-processor install-proof-coordinator \
	install-blockscout install-frontends install-testnet-activity-helper install-all \
	delete-all delete-dogecoin  delete-celestia delete-frontends \
	delete-blockscout delete-withdrawal-processor delete-proof-coordinator delete-tso \
	delete-eth-da-submitter delete-fee-oracle delete-cubesigner-signers \
	delete-testnet-activity-helper \
	delete-l2-reth delete-l2-reth-rpc delete-l2-reth-sequencer delete-l2-reth-bootnode

prepare:
	helm repo add grafana https://grafana.github.io/helm-charts
	helm repo update

# Standard proof release layout. With these names the CLI needs no path flags.
check-proof-config-inputs:
ifneq ($(strip $(PROOF_CONFIG_INPUTS)),)
	@set -eu; \
	missing=""; \
	for file in $(PROOF_CONFIG_INPUTS); do \
		if [ ! -f "$$file" ]; then missing="$$missing\n  - $$file"; fi; \
	done; \
	if [ -n "$$missing" ]; then \
		printf 'proof-config requires release files that are currently missing:%b\n' "$$missing" >&2; \
		exit 1; \
	fi
endif

check-withdrawal-proof-install-inputs:
	@set -eu; \
	missing=""; \
	for file in $(WITHDRAWAL_PROOF_INSTALL_INPUTS); do \
		if [ ! -f "$$file" ]; then missing="$$missing\n  - $$file"; fi; \
	done; \
	if [ -n "$$missing" ]; then \
		printf 'withdrawal-processor proof install requires files that are currently missing:%b\nRun make proof-config first.\n' "$$missing" >&2; \
		exit 1; \
	fi

check-proof-coordinator-install-inputs:
	@set -eu; \
	missing=""; \
	for file in $(PROOF_COORDINATOR_INSTALL_INPUTS); do \
		if [ ! -f "$$file" ]; then missing="$$missing\n  - $$file"; fi; \
	done; \
	if [ -n "$$missing" ]; then \
		printf 'proof-coordinator install requires files that are currently missing:%b\nRun make proof-config first.\n' "$$missing" >&2; \
		exit 1; \
	fi

# Provision the AWS side of the proof system (S3 bucket, IRSA IAM roles,
# proof-work/prover-worker token secret) and project the results into
# values/. Run once before proof-config; idempotent afterwards.
proof-aws-init:
	@test -n "$(AWS_REGION)" -a -n "$(EKS_CLUSTER)" -a -n "$(NETWORK_ALIAS)" || { \
		echo 'Set AWS_REGION, EKS_CLUSTER, and NETWORK_ALIAS for proof-aws-init' >&2; \
		exit 1; \
	}
	scrollsdk setup proof-aws-init \
		--aws-region $(AWS_REGION) \
		--eks-cluster $(EKS_CLUSTER) \
		--network-alias $(NETWORK_ALIAS) \
		--namespace $(NAMESPACE) \
		$(PROOF_AWS_INIT_FLAGS)

proof-config: check-proof-config-inputs
	@test -n "$(PROOF_ARTIFACT_BASE_URL)" || { \
		echo 'Set PROOF_ARTIFACT_BASE_URL to the public proof-object GET root (https://...)' >&2; \
		exit 1; \
	}
	scrollsdk setup proof-config \
		--proving-mode $(PROVING_MODE) \
		--proof-artifact-base-url $(PROOF_ARTIFACT_BASE_URL) $(PROOF_CONFIG_FLAGS)

install-dogecoin:
	helm upgrade -i dogecoin-testnet oci://ghcr.io/dogeos69/scroll-sdk/helm/dogecoin -n $(NAMESPACE) \
		--version=0.1.12 \
		--values values/dogecoin-production.yaml

install-blockbook:
	helm upgrade -i blockbook-testnet oci://ghcr.io/dogeos69/scroll-sdk/helm/blockbook -n $(NAMESPACE) \
		--version=0.1.4 \
		--values values/blockbook-production.yaml

install-celestia:
	helm upgrade -i celestia-testnet oci://ghcr.io/dogeos69/scroll-sdk/helm/celestia-node -n $(NAMESPACE) \
		--version=0.1.13 \
		--values values/celestia-node-production.yaml

install-l1-interface:
	helm upgrade -i l1-interface oci://ghcr.io/dogeos69/scroll-sdk/helm/l1-interface -n $(NAMESPACE) \
		--version=0.0.21 \
		--values values/l1-interface-production.yaml

install-l1-devnet:
	helm upgrade -i l1-devnet oci://ghcr.io/dogeos69/scroll-sdk/helm/l1-devnet -n $(NAMESPACE) \
		--wait  \
		--version=0.1.6-dogeos \
		--values values/l1-devnet-production.yaml

install-scroll-monitor:
	helm upgrade -i scroll-monitor oci://ghcr.io/dogeos69/scroll-sdk/helm/scroll-monitor -n $(NAMESPACE) \
		--version=0.1.23-dogeos \
		--values values/scroll-monitor-production.yaml

install-scroll-common:
	helm upgrade -i scroll-common oci://ghcr.io/dogeos69/scroll-sdk/helm/scroll-common -n $(NAMESPACE) \
		--version=0.3.2-dogeos \
		--values values/genesis.yaml \
		--values values/protocol_context.yaml

install-scroll-core:
	$(MAKE) install-scroll-monitor
	$(MAKE) install-scroll-common
	$(MAKE) install-l1-interface

	helm upgrade -i metrics-exporter oci://ghcr.io/dogeos69/scroll-sdk/helm/metrics-exporter -n $(NAMESPACE) \
		--version=0.1.8 \
		--values values/metrics-exporter-production.yaml

	$(MAKE) install-l2-reth-sequencer
	$(MAKE) install-l2-reth-bootnode
	$(MAKE) install-l2-reth-rpc

install-l2-reth-sequencer:
	helm upgrade -i l2-reth-sequencer-0 $(L2_RETH_CHART) -n $(NAMESPACE) \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-sequencer-production-0.yaml \
		$(L2_RETH_GENESIS_NORMALIZER_ARGS)

	helm upgrade -i l2-reth-sequencer-1 $(L2_RETH_CHART) -n $(NAMESPACE) \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-sequencer-production-1.yaml \
		$(L2_RETH_GENESIS_NORMALIZER_ARGS)


install-l2-reth-rpc:
	helm upgrade -i l2-reth-rpc $(L2_RETH_CHART) -n $(NAMESPACE) \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-rpc-production.yaml \
		$(L2_RETH_GENESIS_NORMALIZER_ARGS)

	helm upgrade -i l2-reth-rpc-public $(L2_RETH_CHART) -n $(NAMESPACE) \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-rpc-public-production.yaml \
		$(L2_RETH_GENESIS_NORMALIZER_ARGS)

install-l2-reth-bootnode:
	helm upgrade -i l2-reth-bootnode-0 $(L2_RETH_CHART) -n $(NAMESPACE) \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-bootnode-production-0.yaml \
		$(L2_RETH_GENESIS_NORMALIZER_ARGS)

	helm upgrade -i l2-reth-bootnode-1 $(L2_RETH_CHART) -n $(NAMESPACE) \
		--version $(L2_RETH_CHART_VERSION) \
		--values values/l2-reth-bootnode-production-1.yaml \
		$(L2_RETH_GENESIS_NORMALIZER_ARGS)

install-contracts:
	helm upgrade -i contracts oci://ghcr.io/dogeos69/scroll-sdk/helm/contracts -n $(NAMESPACE) \
		--version=0.1.22 \
		--values values/contracts-production.yaml \
		--values values/scroll-common-config-contracts.yaml \
		--values values/scroll-common-config.yaml
	kubectl wait --for=jsonpath='{.status.phase}'=Succeeded --timeout=600s pod -l app.kubernetes.io/instance=contracts -n $(NAMESPACE)

install-eth-da-submitter:
	helm upgrade -i eth-da-submitter oci://ghcr.io/dogeos69/scroll-sdk/helm/eth-da-submitter -n $(NAMESPACE) \
		--version=0.1.2 \
		--values values/eth-da-submitter-production.yaml \
		--wait

install-fee-oracle:
	helm upgrade -i fee-oracle oci://ghcr.io/dogeos69/scroll-sdk/helm/fee-oracle -n $(NAMESPACE) \
		--version=0.0.10 \
		--values values/fee-oracle-production.yaml

install-cubesigner-signers:
	helm upgrade -i cubesigner-signer-0 oci://ghcr.io/dogeos69/scroll-sdk/helm/cubesigner-signer -n $(NAMESPACE) \
	 	--version=0.1.7 \
		--values values/cubesigner-signer-production-0.yaml

install-tso:
	helm upgrade -i tso-service oci://ghcr.io/dogeos69/scroll-sdk/helm/tso-service -n $(NAMESPACE) \
		--version=0.1.5 \
		--values values/tso-service-production.yaml \
		--wait

install-withdrawal-processor: check-withdrawal-proof-install-inputs
	helm upgrade -i withdrawal-processor oci://ghcr.io/dogeos69/scroll-sdk/helm/withdrawal-processor -n $(NAMESPACE) \
		--version=0.1.20 \
		--values values/withdrawal-processor-production.yaml \
		--set-file 'configMaps.config.data.WithdrawalProcessor\.toml'=$(WITHDRAWAL_PROCESSOR_CONFIG) \
		--set-file 'configMaps.proof-manifests.data.$(PROOF_CHUNK_MANIFEST_KEY)'=$(PROOF_CHUNK_MANIFEST) \
		--set-file 'configMaps.proof-manifests.data.$(PROOF_BATCH_MANIFEST_KEY)'=$(PROOF_BATCH_MANIFEST) \
		--set-file 'configMaps.proof-manifests.data.$(PROOF_BRIDGE_MANIFEST_KEY)'=$(PROOF_BRIDGE_MANIFEST)

install-proof-coordinator: check-proof-coordinator-install-inputs
	helm upgrade -i proof-coordinator $(PROOF_COORDINATOR_CHART) -n $(NAMESPACE) \
		--version $(PROOF_COORDINATOR_CHART_VERSION) \
		--values values/proof-coordinator-production.yaml \
		--set-file proofCoordinator.config.content=$(PROOF_COORDINATOR_CONFIG) \
		--set-file 'configMaps.manifests.data.$(PROOF_CHUNK_MANIFEST_KEY)'=$(PROOF_CHUNK_MANIFEST) \
		--set-file 'configMaps.manifests.data.$(PROOF_BATCH_MANIFEST_KEY)'=$(PROOF_BATCH_MANIFEST) \
		--set-file 'configMaps.manifests.data.$(PROOF_BRIDGE_MANIFEST_KEY)'=$(PROOF_BRIDGE_MANIFEST) \
		--set-file 'configMaps.manifests.data.statement-namespace\.json'=$(PROOF_STATEMENT_NAMESPACE_CONFIG)

install-blockscout:
	helm upgrade -i blockscout oci://ghcr.io/dogeos69/scroll-sdk/helm/blockscout -n $(NAMESPACE) \
		--version=0.1.9-dogeos \
		--values values/blockscout-production.yaml

	helm upgrade -i blockscout-sc-verifier oci://ghcr.io/dogeos69/scroll-sdk/helm/blockscout-sc-verifier -n $(NAMESPACE) \
		--version=0.1.6-dogeos

install-frontends:
	helm upgrade -i frontends oci://ghcr.io/dogeos69/scroll-sdk/helm/frontends -n $(NAMESPACE) \
		--version=0.1.2-dogeos \
		--values values/frontends-production.yaml \
		--values values/frontends-config.yaml


install-testnet-activity-helper:
	helm upgrade -i testnet-activity-helper oci://ghcr.io/dogeos69/scroll-sdk/helm/testnet-activity-helper -n $(NAMESPACE) \
		--version=0.1.2 \
		--values values/testnet-activity-helper-production.yaml

start-l1-sync:
	kubectl run "start-l1-sync-$$(date +%s)" \
		-n $(NAMESPACE) \
		--image=$(CURL_IMAGE) \
		--restart=Never \
		--rm \
		-i \
		--quiet \
		--command -- \
		curl -fsS -X POST http://l1-interface:9091/disable-genesis-hold

check-install-all-values:
	@set -eu; \
	missing=""; \
	for file in $(INSTALL_ALL_REQUIRED_VALUES); do \
		if [ ! -f "$$file" ]; then missing="$$missing\n  - $$file"; fi; \
	done; \
	if [ -n "$$missing" ]; then \
		printf 'install-all requires values files that are currently missing:%b\n' "$$missing" >&2; \
		exit 1; \
	fi

install-all: check-install-all-values
	kubectl wait --for=condition=Ready --timeout=600s pod -l app.kubernetes.io/instance=dogecoin-testnet && scrollsdk setup dogecoin-wallet-import
	$(MAKE) install-scroll-core
	kubectl wait --for=condition=Ready --timeout=600s pod -l app.kubernetes.io/instance=l1-interface -n $(NAMESPACE)
	$(MAKE) install-contracts
	scrollsdk helper fund-accounts -l 2 -f 0.2 -d
	$(MAKE) install-eth-da-submitter
	$(MAKE) install-fee-oracle
	$(MAKE) install-cubesigner-signers
	$(MAKE) install-tso
	$(MAKE) proof-config
	$(MAKE) install-withdrawal-processor
	$(MAKE) install-proof-coordinator
	$(MAKE) install-blockscout
	$(MAKE) install-frontends
	$(MAKE) install-testnet-activity-helper
	$(MAKE) start-l1-sync

delete-all:
	helm delete -n $(NAMESPACE) scroll-common || true
	$(MAKE) delete-l2-reth || true
	helm delete -n $(NAMESPACE) frontends || true
	helm delete -n $(NAMESPACE) fee-oracle || true
	helm delete -n $(NAMESPACE) contracts || true
	helm delete -n $(NAMESPACE) scroll-monitor || true
	helm delete -n $(NAMESPACE) metrics-exporter || true
	helm delete -n $(NAMESPACE) blockscout || true
	helm delete -n $(NAMESPACE) blockscout-sc-verifier || true
	helm delete -n $(NAMESPACE) withdrawal-processor || true
	helm delete -n $(NAMESPACE) proof-coordinator || true
	helm delete -n $(NAMESPACE) tso-service || true
	$(MAKE) delete-cubesigner-signers || true
	helm delete -n $(NAMESPACE) eth-da-submitter || true
	helm delete -n $(NAMESPACE) l1-interface || true
	$(MAKE) delete-testnet-activity-helper || true

delete-l1-interface:
	helm delete -n $(NAMESPACE) l1-interface

delete-l1-devnet:
	helm delete -n $(NAMESPACE) l1-devnet

delete-dogecoin:
	helm delete -n $(NAMESPACE) dogecoin-testnet

delete-blockbook:
	helm delete -n $(NAMESPACE) blockbook-testnet

delete-celestia:
	helm delete -n $(NAMESPACE) celestia-testnet

delete-frontends:
	helm delete -n $(NAMESPACE) frontends

delete-blockscout:
	helm delete -n $(NAMESPACE) blockscout || true
	helm delete -n $(NAMESPACE) blockscout-sc-verifier || true

delete-withdrawal-processor:
	helm delete -n $(NAMESPACE) withdrawal-processor

delete-proof-coordinator:
	helm delete -n $(NAMESPACE) proof-coordinator

delete-tso:
	helm delete -n $(NAMESPACE) tso-service

delete-eth-da-submitter:
	helm delete -n $(NAMESPACE) eth-da-submitter

delete-fee-oracle:
	helm delete -n $(NAMESPACE) fee-oracle

delete-cubesigner-signers:
	helm delete -n $(NAMESPACE) cubesigner-signer-0 || true

delete-testnet-activity-helper:
	helm delete -n $(NAMESPACE) testnet-activity-helper

delete-l2-reth-rpc:
	helm delete -n $(NAMESPACE) l2-reth-rpc

delete-l2-reth:
	$(MAKE) delete-l2-reth-rpc || true
	$(MAKE) delete-l2-reth-sequencer || true
	$(MAKE) delete-l2-reth-bootnode || true

delete-l2-reth-sequencer:
	helm delete -n $(NAMESPACE) l2-reth-sequencer-0 || true
	helm delete -n $(NAMESPACE) l2-reth-sequencer-1 || true
	kubectl delete pvc -n $(NAMESPACE) l2-reth-sequencer-0-data || true
	kubectl delete pvc -n $(NAMESPACE) l2-reth-sequencer-1-data || true

delete-l2-reth-bootnode:
	helm delete -n $(NAMESPACE) l2-reth-bootnode-0 || true
	kubectl delete pvc -n $(NAMESPACE) l2-reth-bootnode-0-data || true
	helm delete -n $(NAMESPACE) l2-reth-bootnode-1 || true
	kubectl delete pvc -n $(NAMESPACE) l2-reth-bootnode-1-data || true
