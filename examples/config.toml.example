# Shared contracts / scroll-sdk-cli template.
# Fill account and database placeholders for the components you use.
# Contract scripts also accept DEPLOYER_PRIVATE_KEY through the environment.
# The deploy image also requires L2_RPC_ENDPOINT in its environment.
# Reth/service signer configuration belongs in .data/doge-config.toml.
# See docs/config-template-audit.md for retained fields and verification scope.

[general]

L1_RPC_ENDPOINT = "http://l1-interface:8545"
L2_RPC_ENDPOINT = "http://l2-rpc:8545"

CHAIN_NAME_L1 = "DOGE"
CHAIN_NAME_L2 = "DogeOS Devnet"
CHAIN_ID_L1 = 111111
CHAIN_ID_L2 = 221122

L1_CONTRACT_DEPLOYMENT_BLOCK = 0

[accounts]

DEPLOYER_PRIVATE_KEY = ""

DEPLOYER_ADDR = ""
OWNER_ADDR = ""

# Required: nonzero EVM address of the L2 gas oracle service signer (including KMS/HSM).
# Deployment whitelists this address; the service private key is not needed here.
L2_GAS_ORACLE_SENDER_ADDR = ""

[db]

BLOCKSCOUT_DB_CONNECTION_STRING = ""

[frontend]

EXTERNAL_RPC_URI_L1 = "https://sochain.com/DOGETEST"
EXTERNAL_RPC_URI_L2 = "http://rpc.scrollsdk"
EXTERNAL_EXPLORER_URI_L1 = "https://sochain.com/DOGETEST"
EXTERNAL_EXPLORER_URI_L2 = "http://blockscout.scrollsdk"
GRAFANA_URI = "http://grafana.scrollsdk"

ETH_SYMBOL = "DOGE"
CONNECT_WALLET_PROJECT_ID = "14efbaafcf5232a47d93a68229b71028"

[genesis]

L2_MAX_NATIVE_DOGE_SUPPLY = "226156424291633194186662080095093570025917938800079226639565593765455331328"
L2_DEPLOYER_INITIAL_BALANCE = 1000000000000000000
BASE_FEE_PER_GAS = 100000000

[contracts]

DEPLOYMENT_SALT = "salt-000"

# contracts deployed outside this script
L1_FEE_VAULT_ADDR = "0x0000000000000000000000000000000000000001"
L2_BRIDGE_FEE_RECIPIENT_ADDR = "0x0000000000000000000000000000000000000000"
# Dogecoin P2PKH hash160 (20 bytes, encoded as an address) receiving fee vault
# withdrawals via the FeeVaultMoatAdapter. Required: deployment fails if unset.
FEE_VAULT_DOGE_RECIPIENT_ADDR = "0x0000000000000000000000000000000000000000"
DEPOSIT_FEE = "1000000000000000000"   # 1.0 DOGE default deposit fee
WITHDRAWAL_FEE = "100000000000000000" # 0.1 DOGE default withdrawal fee
MIN_WITHDRAWAL_AMOUNT = "1000000000000000000" # 1.0 DOGE minimum withdrawal amount

# L1GasPriceOracle.
# Galileo uses COMMIT_SCALAR, BLOB_SCALAR, and PENALTY_FACTOR.
# SCALAR is the deprecated pre-Curie/pre-Galileo scalar and is kept only for
# compatibility with legacy formula branches.
COMMIT_SCALAR = 38_720_000_000
BLOB_SCALAR = 8_000_000_000
SCALAR = 938846
PENALTY_FACTOR = 10_000

[contracts.overrides]

L2_MESSAGE_QUEUE = "0x5300000000000000000000000000000000000000"
L1_GAS_PRICE_ORACLE = "0x5300000000000000000000000000000000000002"
L2_WHITELIST = "0x5300000000000000000000000000000000000003"
L2_WDOGE = "0x5300000000000000000000000000000000000004"
L2_TX_FEE_VAULT = "0x5300000000000000000000000000000000000005"
L2_NATIVE_DOGE_TOKEN = "0x530000000000000000000000000000000000d09e"

[contracts.verification]

VERIFIER_TYPE_L2 = "blockscout"
EXPLORER_URI_L2 = "http://blockscout.scrollsdk"
RPC_URI_L2 = "http://rpc.scrollsdk"
EXPLORER_API_KEY_L2 = ""

[ingress]

FRONTEND_HOST = "portal.scrollsdk"
RPC_GATEWAY_HOST = "rpc.scrollsdk"
# Browser UI at / and API at /api share this host.
BLOCKSCOUT_HOST = "blockscout.scrollsdk"
L1_DEVNET_HOST = "l1-devnet.scrollsdk"
GRAFANA_HOST = "grafana.scrollsdk"

# Public TSO endpoint used by signer callbacks; setup domains configures this host.
TSO_HOST = "tso.scrollsdk"

# Public prover API; prep-charts enables this ingress when proof mode is active.
PROOF_COORDINATOR_HOST = "proof-coordinator.scrollsdk"
