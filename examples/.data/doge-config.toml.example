# Minimal non-secret doge-config shape. The normal setup command fills the
# ordinary Dogecoin and Ethereum DA sections.
network = "testnet"

[wallet]
path = ".data/doge-wallet-testnet.json"

# Do not copy proof image digests, VK hashes, commitments, or release paths by
# hand. After protocol_context.json and proof AWS resources are ready, import
# the immutable OCI release printed by the dogeos-core release workflow:
#
#   scrollsdk setup proof-release-init \
#     --release-image dogeos69/proof-release@sha256:<digest>
#   scrollsdk setup doge-config --proof-topology
#
# These commands bake deployment-bound Bridge material on CPU and write
# [proof_release] plus complete dormant
# [proof_topology.mock] and [proof_topology.production] blocks, preflights both,
# and leaves proof_topology.mode = "disabled" by default. An ordinary later
# transition changes only that mode value before rerunning setup prep-charts.
