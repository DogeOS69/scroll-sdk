# DeploymentSpec environment template. Credentials below are NONFUNCTIONAL placeholders.
# Public Ethereum endpoint defaults are provided in the two spec examples.
# Copy this file outside the source checkout as deployment.env (mode 0600).
# Fill the entries needed by your selected workflow; remove unused entries.
# Add one NAME=value entry for each custom $ENV:NAME, privateKeyEnv,
# sequencerKeyEnv or databaseUrlEnv reference in your spec.
# The CLI reads literal NAME=value data: no shell expansion or command execution.
# Keep comments on separate lines. Do not commit the completed file.
# Shared operator environment template for deployment-spec.testnet.example.yaml
# and deployment-spec.mainnet.example.yaml. Select the matching network below.

# The SDK plan/apply spec example references these variables.
# database.admin.password: password for the existing PostgreSQL administrator.
DB_ADMIN_PASSWORD=REPLACE_WITH_DATABASE_ADMIN_PASSWORD
# accounts.owner.address: public Ethereum/L2 owner or multisig address, not a key.
OWNER_ADDRESS=REPLACE_WITH_PUBLIC_OWNER_ADDRESS
# bridge.feeRecipient: dedicated L2/EVM wallet or multisig address receiving
# Moat bridge fees. Choose separately from OWNER_ADDRESS; supply only the public
# address, not its private key or the Dogecoin fee-vault withdrawal address.
L2_BRIDGE_FEE_RECIPIENT_ADDRESS=REPLACE_WITH_PUBLIC_L2_BRIDGE_FEE_RECIPIENT_ADDRESS
# Optional accounts.deployer.privateKey: uncomment together with the deployer
# block in deployment-spec.yaml to supply a key before the first plan/apply.
# Use an EVM private key: 0x followed by 64 hexadecimal characters, not Dogecoin
# WIF or a KMS key ID. The CLI derives the deployer address from this key.
# Leave both entries commented to let apply generate and save a random deployer.
# DEPLOYER_PRIVATE_KEY=REPLACE_WITH_YOUR_0x_PREFIXED_64_HEX_PRIVATE_KEY
# dogecoin.externalRpc: credentials used from the operator's machine.
DOGECOIN_EXTERNAL_RPC_USERNAME=REPLACE_WITH_EXTERNAL_DOGECOIN_RPC_USERNAME
DOGECOIN_EXTERNAL_RPC_PASSWORD=REPLACE_WITH_EXTERNAL_DOGECOIN_RPC_PASSWORD
# dogecoin.clusterRpc: credentials used by services inside the cluster.
DOGECOIN_CLUSTER_RPC_USERNAME=REPLACE_WITH_CLUSTER_DOGECOIN_RPC_USERNAME
DOGECOIN_CLUSTER_RPC_PASSWORD=REPLACE_WITH_CLUSTER_DOGECOIN_RPC_PASSWORD

# Optional authenticated Ethereum provider overrides. Both spec examples already
# contain credential-free public URLs for their selected DA network; Fee Oracle
# samples Ethereum mainnet in both examples.
# To override, change the matching spec field to $ENV:NAME and uncomment/fill
# its entry below. Setting an env entry alone does not replace a literal spec URL.
# ethereumDa.l1RpcUrl: "$ENV:ETHEREUM_RPC_URL"
# ethereumDa.beaconRpcUrl: "$ENV:ETHEREUM_BEACON_RPC_URL"
# feeOracle.ethereumRpcUrl: "$ENV:FEE_ORACLE_ETHEREUM_RPC_URL"
# Store the full URL, including any API key. DA URLs must match ethereumDa.chain.
# ETHEREUM_RPC_URL=REPLACE_WITH_ETHEREUM_EXECUTION_RPC_URL
# ETHEREUM_BEACON_RPC_URL=REPLACE_WITH_ETHEREUM_BEACON_RPC_URL
# FEE_ORACLE_ETHEREUM_RPC_URL=REPLACE_WITH_ETHEREUM_MAINNET_RPC_URL

# Production Bridge fee wallet remains local in beta.6-kms.
# Use compressed WIF for the chosen network. Apply derives and pins its public
# key and funding address; there are no fee-wallet key fields in the spec.
# These are NOT the L2 Reth/Ethereum sequencer signer or the external funding wallet.
DOGECOIN_FEE_WALLET_KEY=REPLACE_WITH_DOGECOIN_FEE_WALLET_WIF
# Only for the optional local Bridge sequencer backend (omit with sequencerKms):
# DOGECOIN_SEQUENCER_KEY=REPLACE_WITH_DOGECOIN_SEQUENCER_WIF

# Optional local L2 signer import, matching the example in docs/spec-projection.md:
# identities.sequencers[0].signer.privateKeyEnv: SEQUENCER_SIGNING_KEY
# Use a 0x-prefixed, 32-byte Ethereum private key. Omit for create or AWS KMS.
# SEQUENCER_SIGNING_KEY=REPLACE_ME

# Optional existing dstack PostgreSQL database, instead of initializeDatabase:
# preparation.dstack.databaseUrlEnv: DSTACK_DATABASE_URL
# Supply the full postgresql+asyncpg URL with ssl (not sslmode); URL-encode credentials.
# Omit for SQLite or when initializeDatabase is true.
# DSTACK_DATABASE_URL=REPLACE_WITH_EXISTING_DSTACK_ASYNCPG_DATABASE_URL

# AWS/KMS uses the normal SDK credential provider chain (for example an AWS profile).
# preparation.dstack.vastaiApiKeyEnv: VASTAI_API_KEY (a string, no separate file needed).
VASTAI_API_KEY=REPLACE_WITH_VASTAI_API_KEY
# File-based Vast.ai credentials and GCP service-account JSON remain supported.
# Funding txid/vout are separate files, not environment values.

# Optional Slack alert delivery: required when monitoring.slack.enabled is true.
# Fixed input name; the spec and Helm values contain no webhook credential.
# SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL

# Instatus management credential for setup status-page --plan / --apply.
# Loaded automatically from the saved preparation env file or deployment.env;
# an existing process variable takes precedence. No extra export is required.
# CLI-only: never copied into Helm values, Kubernetes Secrets or running services.
# Runtime component webhook/heartbeat URLs are generated separately under secrets/status-page/.
INSTATUS_API_KEY=REPLACE_WITH_INSTATUS_API_KEY
