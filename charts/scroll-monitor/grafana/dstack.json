{
  "uid": "dogeos-dstack",
  "title": "DogeOS / Dstack and GPU fleets",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "dogeos",
    "dstack",
    "gpu",
    "internal"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Coverage and interpretation",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Native metrics show the controller’s latest cached observation. **A successful scrape does not establish GPU reachability or freshness.** Fleet GPU counts are allocated capacity, not a hardware health check. Empty job panels can mean no active tasks. Hardware panels require DCGM support. Host panels require the optional always-on Alloy collector. Proof completion is monitored separately in the proof-coordinator / worker dashboards."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Native endpoint scrape",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{dstack_namespace=~\"$dstack_namespace\",dstack_controller=~\"$controller\",dstack_source=\"native\"}",
          "legendFormat": "{{dstack_namespace}} {{dstack_controller}} {{dstack_project_name}} {{dstack_run_name}} {{dstack_job_name}} {{dstack_gpu_num}} {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Native scrape duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{dstack_namespace=~\"$dstack_namespace\",dstack_controller=~\"$controller\",dstack_source=\"native\"}",
          "legendFormat": "{{dstack_namespace}} {{dstack_controller}} {{dstack_project_name}} {{dstack_run_name}} {{dstack_job_name}} {{dstack_gpu_num}} {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Allocated fleet GPUs (not health)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dstack_namespace,dstack_controller,dstack_project_name,dstack_fleet_name,dstack_gpu) (dstack_instance_gpu_count{dstack_source=\"native\",dstack_namespace=~\"$dstack_namespace\",dstack_controller=~\"$controller\",dstack_project_name=~\"$project\"})",
          "legendFormat": "{{dstack_namespace}} {{dstack_controller}} {{dstack_project_name}} {{dstack_fleet_name}} {{dstack_gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Estimated fleet price / hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dstack_namespace,dstack_controller,dstack_project_name) (dstack_instance_price_dollars_per_hour{dstack_source=\"native\",dstack_namespace=~\"$dstack_namespace\",dstack_controller=~\"$controller\",dstack_project_name=~\"$project\"})",
          "legendFormat": "{{dstack_namespace}} {{dstack_controller}} {{dstack_project_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed runs / 10m",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dstack_namespace,dstack_controller,dstack_project_name) (increase(dstack_run_count_failed_total{dstack_source=\"native\",dstack_namespace=~\"$dstack_namespace\",dstack_controller=~\"$controller\",dstack_project_name=~\"$project\"}[10m]))",
          "legendFormat": "{{dstack_namespace}} {{dstack_controller}} {{dstack_project_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Increase of the controller-exported run-count counter, grouped by project. These counters are reconstructed from retained run records; deleting records or resetting state can affect the estimate."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Completed runs / 10m",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dstack_namespace,dstack_controller,dstack_project_name) (increase(dstack_run_count_done_total{dstack_source=\"native\",dstack_namespace=~\"$dstack_namespace\",dstack_controller=~\"$controller\",dstack_project_name=~\"$project\"}[10m]))",
          "legendFormat": "{{dstack_namespace}} {{dstack_controller}} {{dstack_project_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Increase of the controller-exported run-count counter, grouped by project. These counters are reconstructed from retained run records; deleting records or resetting state can affect the estimate."
    },
