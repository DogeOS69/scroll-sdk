{
  "annotations": {"list": []},
  "description": "Proof Coordinator Kubernetes runtime and WP-owned proof queues, with claim-gate, worker API, lease and run-loop metrics available when dogeos-core #1007 is deployed.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 114,
      "type": "text",
      "title": "Coverage",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "Kubernetes panels describe the coordinator Pod; durable queues come from Withdrawal Processor. Application readiness, leases and worker progress in the collapsed row require [dogeos-core #1007](https://github.com/DogeOS69/dogeos-core/pull/1007) and its deployed /metrics endpoint. They are not inferred from Pod readiness."}
    },
    {
      "id": 101,
      "title": "Coordinator Pod Ready",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data"}, "overrides": []},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "min by (namespace, pod) (kube_pod_status_ready{namespace=~\"$namespace\",pod=~\".*proof-coordinator.*\",condition=\"true\"})", "legendFormat": "{{namespace}} {{pod}}", "instant": true, "range": false}]
    },
    {
      "id": 102,
      "title": "Container Restarts in Selected Range",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data"}, "overrides": []},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\".*proof-coordinator.*\"}[$__range]))", "legendFormat": "{{namespace}} {{pod}}"}]
    },
    {
      "id": 103,
      "title": "Coordinator CPU Usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {"unit": "cores", "noValue": "No data"}, "overrides": []},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\".*proof-coordinator.*\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval]))", "legendFormat": "{{namespace}} {{pod}}"}]
    },
    {
      "id": 104,
      "title": "Coordinator Memory Working Set",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "No data"}, "overrides": []},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\".*proof-coordinator.*\",container!=\"\",container!=\"POD\",image!=\"\"})", "legendFormat": "{{namespace}} {{pod}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "The durable proof queue is owned by Withdrawal Processor, not Proof Coordinator.",
      "fieldConfig": {"defaults": {"unit": "none", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21},
      "id": 112,
      "targets": [{"expr": "max by (namespace, proof_family, phase, status) (withdrawal_processor_proof_work_item_count{namespace=~\"$wp_namespace\"})", "legendFormat": "{{namespace}} {{proof_family}} {{phase}} {{status}}", "refId": "A"}],
      "title": "Durable Proof Queue (WP-owned)",
      "type": "timeseries"
    },
    {
      "id": 115,
      "title": "Oldest Active or Failed Proof Work (WP-owned)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 29},
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []},
      "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max by (namespace, proof_family, phase, status) (withdrawal_processor_proof_work_oldest_age_seconds{namespace=~\"$wp_namespace\",status=~\"pending|leased|running|remote_result_submitted|blocked|failed_retryable|failed_terminal\"})", "legendFormat": "{{namespace}} {{proof_family}} {{phase}} {{status}}"}]
    },
    {
      "id": 120,
      "type": "row",
      "title": "Application metrics — requires core #1007",
      "collapsed": true,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 37},
      "panels": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Whether the worker claim plane is ready to admit a claim.",
          "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "Not ready"}, "1": {"color": "green", "text": "Ready"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38},
          "id": 1,
          "targets": [{"expr": "min by (instance) (proof_coordinator_ready{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Claim Plane Ready",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Seconds since the last processed or idle proof-work loop tick.",
          "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 300}]}, "unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38},
          "id": 2,
          "targets": [{"expr": "clamp_min(time() - max by (instance) ((proof_coordinator_run_loop_last_success_timestamp_seconds{job=~\"$job\",instance=~\"$instance\"} > 0)), 0)", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Run-loop Last-success Age",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46},
          "id": 3,
          "targets": [{"expr": "max by (instance) (proof_coordinator_run_loop_consecutive_failures{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Run-loop Consecutive Failures",
          "type": "stat",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 46},
          "id": 4,
          "targets": [{"expr": "sum by (instance) (proof_coordinator_active_worker_leases{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Active Worker Leases",
          "type": "stat",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. One-hot claim state: ready, terminal WP fault, upload-issuance cooldown, or probe-ready.",
          "fieldConfig": {"defaults": {"unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 54},
          "id": 5,
          "targets": [{"expr": "max by (instance, state) (proof_coordinator_claim_gate_state{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "{{instance}} {{state}}", "refId": "A"}],
          "title": "Claim-gate State",
          "type": "state-timeline"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 54},
          "id": 6,
          "targets": [{"expr": "max by (instance, kind) (proof_coordinator_active_worker_leases{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "{{instance}} {{kind}}", "refId": "A"}],
          "title": "Active Leases by Proof Kind",
          "type": "timeseries",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
          "id": 7,
          "targets": [{"expr": "sum by (instance, handler, status) (rate(proof_coordinator_worker_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{handler}} HTTP {{status}}", "refId": "A"}],
          "title": "Worker API Request Rate",
          "type": "timeseries",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Worker API latency distribution from explicit Prometheus buckets.",
          "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 62},
          "id": 8,
          "targets": [
            {"expr": "histogram_quantile(0.50, sum by (le, instance, handler) (rate(proof_coordinator_worker_request_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 {{instance}} {{handler}}", "refId": "A"},
            {"expr": "histogram_quantile(0.95, sum by (le, instance, handler) (rate(proof_coordinator_worker_request_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{instance}} {{handler}}", "refId": "B"},
            {"expr": "histogram_quantile(0.99, sum by (le, instance, handler) (rate(proof_coordinator_worker_request_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p99 {{instance}} {{handler}}", "refId": "C"}
          ],
          "title": "Worker API Latency Distribution",
          "type": "timeseries"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 70},
          "id": 9,
          "targets": [
            {"expr": "sum by (instance, handler) (rate(proof_coordinator_worker_fence_rejections_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "fence {{instance}} {{handler}}", "refId": "A"},
            {"expr": "sum by (instance) (rate(proof_coordinator_terminal_wp_claim_failures_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "terminal WP {{instance}}", "refId": "B"},
            {"expr": "sum by (instance) (rate(proof_coordinator_local_upload_issuance_failures_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "upload issuance {{instance}}", "refId": "C"}
          ],
          "title": "Claim and Worker Failure Rate",
          "type": "timeseries",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 70},
          "id": 10,
          "targets": [{"expr": "sum by (instance, outcome, error_kind) (rate(proof_coordinator_run_loop_ticks_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{outcome}} {{error_kind}}", "refId": "A"}],
          "title": "Proof-work Run-loop Outcomes",
          "type": "timeseries",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Proof-work run-loop latency distribution from explicit Prometheus buckets.",
          "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 78},
          "id": 11,
          "targets": [
            {"expr": "histogram_quantile(0.50, sum by (le, instance, outcome) (rate(proof_coordinator_run_loop_tick_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 {{instance}} {{outcome}}", "refId": "A"},
            {"expr": "histogram_quantile(0.95, sum by (le, instance, outcome) (rate(proof_coordinator_run_loop_tick_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{instance}} {{outcome}}", "refId": "B"},
            {"expr": "histogram_quantile(0.99, sum by (le, instance, outcome) (rate(proof_coordinator_run_loop_tick_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p99 {{instance}} {{outcome}}", "refId": "C"}
          ],
          "title": "Proof-work Tick Latency Distribution",
          "type": "timeseries"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Prometheus scrape health for every selected Proof Coordinator target.",
          "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 78},
          "id": 13,
          "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
          "targets": [{"expr": "min by (instance) (up{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Prometheus Target Up",
          "type": "stat"
        },
        {
          "id": 16,
          "type": "timeseries",
          "title": "Finished Work-item Attempt Rate",
          "description": "Requires dogeos-core #1007. Counts finished claimed attempts, not unique durable work items. Success requires Withdrawal Processor acknowledgement.",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 86},
          "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data", "custom": {"spanNulls": false}}, "overrides": []},
          "targets": [{"refId": "A", "expr": "sum by (instance, phase, proof_family, outcome) (rate(proof_coordinator_work_items_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{phase}} {{proof_family}} {{outcome}}"}]
        },
        {
          "id": 17,
          "type": "timeseries",
          "title": "Claimed Work-item Attempt Duration",
          "description": "Requires dogeos-core #1007. Claim received to attempt finished, including WP result reporting. Excludes claim wait and remote proving; this is not end-to-end proof-generation latency.",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 86},
          "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data", "custom": {"spanNulls": false}}, "overrides": []},
          "targets": [
            {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le, instance, phase, proof_family, outcome) (rate(proof_coordinator_work_item_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}} 0.5 {{phase}} {{proof_family}} {{outcome}}"},
            {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, instance, phase, proof_family, outcome) (rate(proof_coordinator_work_item_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}} 0.95 {{phase}} {{proof_family}} {{outcome}}"},
            {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, instance, phase, proof_family, outcome) (rate(proof_coordinator_work_item_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "{{instance}} 0.99 {{phase}} {{proof_family}} {{outcome}}"}
          ]
        }
      ]
    }
  ],
