{
  "annotations": {"list": []},
  "description": "Attestation Signer readiness, bounded worker load, policy, signing, callbacks and latency. Extended durable queue and worker-freshness panels require dogeos-core #1007.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "One value per scraped signer and policy mode. Zero means /ready would not return HTTP 200.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "Not ready"}, "1": {"color": "green", "text": "Ready"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "min by (instance, mode) (attestation_signer_ready{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}} {{mode}}", "refId": "A", "range": false}],
      "title": "Signer Ready",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Rows loaded by the most recent worker tick. This is a bounded batch, not the total durable queue depth.",
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 100}]}, "unit": "short", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 0},
      "id": 21,
      "targets": [{"expr": "max by (instance) (attestation_signer_worker_active_rows_loaded{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
      "title": "Active Rows Loaded in Last Worker Tick",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 7,
      "targets": [{"expr": "sum by (instance, result, kind) (rate(attestation_signer_intake_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{result}} {{kind}}", "refId": "A"}],
      "title": "Sign-request Intake Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Tick and row rates. Failure kinds are bounded taxonomies, never raw error strings.",
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 8,
      "targets": [
        {"expr": "sum by (instance, result, kind) (rate(attestation_signer_worker_ticks_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "tick {{instance}} {{result}} {{kind}}", "refId": "A"},
        {"expr": "sum by (instance, kind, terminal) (rate(attestation_signer_worker_failures_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "failure {{instance}} {{kind}} terminal={{terminal}}", "refId": "B"},
        {"expr": "sum by (instance, starting_status, result, kind) (rate(attestation_signer_worker_rows_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "row {{instance}} {{starting_status}} {{result}} {{kind}}", "refId": "C"}
      ],
      "title": "Worker Outcomes and Failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Observe mode may sign while emitting observed policy issues. Use classification and reason_code together.",
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 9,
      "targets": [{"expr": "sum by (instance, mode, classification, reason_code) (rate(attestation_signer_policy_decisions_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{mode}} {{classification}} {{reason_code}}", "refId": "A"}],
      "title": "Policy Decision Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 10,
      "targets": [
        {"expr": "sum by (instance, result) (rate(attestation_signer_signing_attempts_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "sign {{instance}} {{result}}", "refId": "A"},
        {"expr": "sum by (instance, path, result) (rate(attestation_signer_tso_callbacks_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "TSO {{instance}} {{path}} {{result}}", "refId": "B"},
        {"expr": "sum by (instance, result) (rate(attestation_signer_release_outcomes_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "release {{instance}} {{result}}", "refId": "C"}
      ],
      "title": "Signing, TSO Callback, and Release Rates",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Percentiles computed from per-bucket counter rates exported by the service. Empty buckets mean no observations; they do not imply zero latency.",
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 12,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, instance, capability) (rate(attestation_signer_queue_wait_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "queue p95 {{instance}} {{capability}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance, capability, decision) (rate(attestation_signer_row_evaluation_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "evaluate p95 {{instance}} {{capability}} {{decision}}", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance, capability, result) (rate(attestation_signer_tso_submit_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "TSO p95 {{instance}} {{capability}} {{result}}", "refId": "C"}
      ],
      "title": "Queue, Evaluation, and TSO p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 13,
      "targets": [
        {"expr": "sum by (instance, transition, result, cache) (rate(attestation_signer_artifact_fetch_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "artifact {{instance}} {{transition}} {{result}} {{cache}}", "refId": "A"},
        {"expr": "sum by (instance, transition, result) (rate(attestation_signer_witness_decode_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "decode {{instance}} {{transition}} {{result}}", "refId": "B"},
        {"expr": "sum by (instance, transition, result) (rate(attestation_signer_rotation_replay_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "rotation replay {{instance}} {{transition}} {{result}}", "refId": "C"},
        {"expr": "sum by (instance, result) (rate(attestation_signer_advance_l1_replay_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "AdvanceL1 replay {{instance}} {{result}}", "refId": "D"},
        {"expr": "sum by (instance, result) (rate(attestation_signer_advance_l2_replay_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "AdvanceL2 replay {{instance}} {{result}}", "refId": "E"}
      ],
      "title": "Artifact, Decode, and Replay Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Percentiles computed from per-bucket counter rates exported by the service. Empty buckets mean no observations; they do not imply zero latency.",
      "fieldConfig": {"defaults": {"unit": "ms", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "id": 14,
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le, instance, transition, result) (rate(attestation_signer_artifact_fetch_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 {{instance}} {{transition}} {{result}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance, transition, result) (rate(attestation_signer_artifact_fetch_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{instance}} {{transition}} {{result}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, instance, transition, result) (rate(attestation_signer_artifact_fetch_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p99 {{instance}} {{transition}} {{result}}", "refId": "C"}
      ],
      "title": "Artifact Fetch Latency Distribution",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Per-instance artifact-size percentiles: current core exports summaries; #1007 exports histogram buckets. Prefer bucket quantiles when available, otherwise use the matching per-instance summary. No cross-instance summary aggregation.",
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "id": 15,
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le, instance, transition) (rate(attestation_signer_artifact_bytes_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))) or on (instance, transition) max by (instance, transition) (attestation_signer_artifact_bytes{job=~\"$job\",instance=~\"$instance\",quantile=\"0.5\"})", "legendFormat": "p50 {{instance}} {{transition}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance, transition) (rate(attestation_signer_artifact_bytes_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))) or on (instance, transition) max by (instance, transition) (attestation_signer_artifact_bytes{job=~\"$job\",instance=~\"$instance\",quantile=\"0.95\"})", "legendFormat": "p95 {{instance}} {{transition}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, instance, transition) (rate(attestation_signer_artifact_bytes_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))) or on (instance, transition) max by (instance, transition) (attestation_signer_artifact_bytes{job=~\"$job\",instance=~\"$instance\",quantile=\"0.99\"})", "legendFormat": "p99 {{instance}} {{transition}}", "refId": "C"}
      ],
      "title": "Artifact Size Distribution",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Percentiles computed from per-bucket counter rates exported by the service. Empty buckets mean no observations; they do not imply zero latency.",
      "fieldConfig": {"defaults": {"unit": "ms", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "id": 16,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, instance, transition) (rate(attestation_signer_rotation_replay_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "rotation p95 {{instance}} {{transition}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance) (rate(attestation_signer_advance_l1_replay_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "AdvanceL1 p95 {{instance}}", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance) (rate(attestation_signer_advance_l2_replay_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "AdvanceL2 p95 {{instance}}", "refId": "C"}
      ],
      "title": "Replay Latency Distribution",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Percentiles computed from per-bucket counter rates exported by the service. Empty buckets mean no observations; they do not imply zero latency.",
      "fieldConfig": {"defaults": {"unit": "ms", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "id": 17,
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le, instance, fact, posture, outcome) (rate(attestation_signer_source_set_evaluation_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 {{instance}} {{fact}} {{posture}} {{outcome}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, instance, fact, posture, outcome) (rate(attestation_signer_source_set_evaluation_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{instance}} {{fact}} {{posture}} {{outcome}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, instance, fact, posture, outcome) (rate(attestation_signer_source_set_evaluation_latency_ms_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p99 {{instance}} {{fact}} {{posture}} {{outcome}}", "refId": "C"}
      ],
      "title": "Source-set Evaluation Latency Distribution",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Bounded transition and source-set outcomes. These counters expose result distributions without request or artifact identifiers.",
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "id": 18,
      "targets": [
        {"expr": "sum by (instance, transition, result) (rate(attestation_signer_rotation_result_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "rotation {{instance}} {{transition}} {{result}}", "refId": "A"},
        {"expr": "sum by (instance, result) (rate(attestation_signer_advance_l1_result_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "AdvanceL1 {{instance}} {{result}}", "refId": "B"},
        {"expr": "sum by (instance, result) (rate(attestation_signer_advance_l2_result_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "AdvanceL2 {{instance}} {{result}}", "refId": "C"},
        {"expr": "sum by (instance, fact, posture, outcome) (rate(attestation_signer_source_set_evaluations_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "source-set {{instance}} {{fact}} {{posture}} {{outcome}}", "refId": "D"},
        {"expr": "sum by (instance, fact, verdict) (rate(attestation_signer_source_verdicts_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "source {{instance}} {{fact}} {{verdict}}", "refId": "E"}
      ],
      "title": "Transition and Source Outcome Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Prometheus scrape health for every selected external signer target. A value of 0 means Prometheus cannot currently scrape that instance.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none", "noValue": "No data"}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 48},
      "id": 19,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [{"expr": "min by (instance) (up{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
      "title": "Prometheus Target Up",
      "type": "stat"
    },
    {
      "id": 20,
      "type": "text",
      "title": "Coverage",
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 56},
      "options": {"mode": "markdown", "content": "The panels above use currently exported signer metrics. Durable backlog, oldest-row age and worker freshness below require [dogeos-core #1007](https://github.com/DogeOS69/dogeos-core/pull/1007), which is still unmerged. No data before deploying that implementation is expected; scrape success does not prove worker progress."}
    },
    {
      "id": 22,
      "type": "row",
      "title": "Extended queue and worker metrics — requires core #1007",
      "collapsed": true,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 61},
      "panels": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007. Age of the last successful worker tick, including idle ticks and handled row failures. This establishes loop freshness, not successful signing.",
          "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 300}]}, "unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
          "id": 2,
          "targets": [{"expr": "clamp_min(time() - max by (instance) ((attestation_signer_worker_last_success_timestamp_seconds{job=~\"$job\",instance=~\"$instance\"} > 0)), 0)", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Worker Last-success Age",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Authoritative durable active rows. This is not capped by the worker's 256-row per-tick load limit.",
          "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 100}]}, "unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 62},
          "id": 3,
          "targets": [{"expr": "sum by (instance) (attestation_signer_queue_rows{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Active Durable Backlog",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. Maximum age among received, signed-waiting-callback, and rejected-policy-waiting-callback rows.",
          "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 600}]}, "unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 70},
          "id": 4,
          "targets": [{"expr": "max by (instance) (attestation_signer_queue_oldest_age_seconds{job=~\"$job\",instance=~\"$instance\"})", "instant": true, "legendFormat": "{{instance}}", "refId": "A", "range": false}],
          "title": "Oldest Active Row",
          "type": "stat"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "none", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 70},
          "id": 5,
          "targets": [{"expr": "max by (instance, status) (attestation_signer_queue_rows{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "{{instance}} {{status}}", "refId": "A"}],
          "title": "Durable Queue Rows by State",
          "type": "timeseries",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 78},
          "id": 6,
          "targets": [{"expr": "max by (instance, status) (attestation_signer_queue_oldest_age_seconds{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "{{instance}} {{status}}", "refId": "A"}],
          "title": "Oldest Queue-row Age by State",
          "type": "timeseries",
          "description": "Requires dogeos-core #1007 and a deployed metrics endpoint. "
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "description": "Requires dogeos-core #1007. Worker-tick duration percentiles are computed from histogram bucket rates, preserving signer instance and result.",
          "fieldConfig": {"defaults": {"unit": "s", "noValue": "No data"}, "overrides": []},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 78},
          "id": 11,
          "targets": [
            {"expr": "histogram_quantile(0.5, sum by (le, instance, result) (rate(attestation_signer_worker_tick_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 {{instance}} {{result}}", "refId": "A"},
            {"expr": "histogram_quantile(0.95, sum by (le, instance, result) (rate(attestation_signer_worker_tick_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{instance}} {{result}}", "refId": "B"},
            {"expr": "histogram_quantile(0.99, sum by (le, instance, result) (rate(attestation_signer_worker_tick_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p99 {{instance}} {{result}}", "refId": "C"}
          ],
          "title": "Worker-tick Latency Distribution",
          "type": "timeseries"
        },
        {
          "id": 23,
          "type": "timeseries",
          "title": "Durable Request Completion Rate",
          "description": "Requires dogeos-core #1007. Durable terminal transitions counted once per completed request; separates submitted, TSO rejection and permanent failure.",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 86},
          "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No data", "custom": {"spanNulls": false}}, "overrides": []},
          "targets": [{"refId": "A", "expr": "sum by (instance, capability, outcome) (rate(attestation_signer_requests_completed_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{instance}} {{capability}} {{outcome}}"}]
        },
        {
          "id": 24,
          "type": "timeseries",
          "title": "Request Lifetime to Durable Completion",
          "description": "Requires dogeos-core #1007. Intake to durable terminal state, including configured signing delay, retries and process downtime. It is not just signing-backend RPC latency.",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 86},
