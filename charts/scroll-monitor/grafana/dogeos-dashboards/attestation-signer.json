    {
      "datasource": {
        "type": "prometheus",
        "uid": "scroll-prometheus"
      },
      "description": "Readiness reported by each configured attestation policy mode; 1 means the service is ready.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scroll-prometheus"
          },
          "expr": "max by (mode) (attestation_signer_ready)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "title": "Service Ready by Policy Mode",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "scroll-prometheus"
      },
      "description": "Active sign-request rows loaded by the most recent background-worker tick.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scroll-prometheus"
          },
          "expr": "max(attestation_signer_worker_active_rows_loaded)",
          "legendFormat": "active rows",
          "refId": "A"
        }
      ],
      "title": "Active Worker Rows Loaded",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "scroll-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scroll-prometheus"
          },
          "expr": "sum by (result, kind) (rate(attestation_signer_intake_requests_total[$__rate_interval]))",
          "legendFormat": "{{result}} {{kind}}",
          "refId": "A"
        }
      ],
      "title": "Sign-request Intake Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "scroll-prometheus"
      },
