# Synthetic Prometheus exposition for dashboard development. No task, worker,
# lease, artifact, URL, or credential identity is present.
# HELP proof_coordinator_ready Whether the worker claim plane is ready
# TYPE proof_coordinator_ready gauge
proof_coordinator_ready 1
# HELP proof_coordinator_claim_gate_state One-hot worker claim-plane state
# TYPE proof_coordinator_claim_gate_state gauge
proof_coordinator_claim_gate_state{state="ready"} 1
proof_coordinator_claim_gate_state{state="terminal_wp_fault"} 0
proof_coordinator_claim_gate_state{state="local_upload_issuance_cooldown"} 0
proof_coordinator_claim_gate_state{state="local_upload_issuance_probe_ready"} 0
# HELP proof_coordinator_active_worker_leases Current worker leases by proof kind
# TYPE proof_coordinator_active_worker_leases gauge
proof_coordinator_active_worker_leases{kind="mock"} 0
proof_coordinator_active_worker_leases{kind="real"} 3
# HELP proof_coordinator_run_loop_consecutive_failures Consecutive run-loop failures
# TYPE proof_coordinator_run_loop_consecutive_failures gauge
proof_coordinator_run_loop_consecutive_failures 0
# HELP proof_coordinator_run_loop_last_success_timestamp_seconds Last successful run-loop tick timestamp
# TYPE proof_coordinator_run_loop_last_success_timestamp_seconds gauge
proof_coordinator_run_loop_last_success_timestamp_seconds 1788500000
# HELP proof_coordinator_worker_requests_total Worker API requests
# TYPE proof_coordinator_worker_requests_total counter
proof_coordinator_worker_requests_total{handler="claim",status="200"} 900
# HELP proof_coordinator_worker_request_duration_seconds Worker API duration
# TYPE proof_coordinator_worker_request_duration_seconds histogram
proof_coordinator_worker_request_duration_seconds_bucket{handler="claim",le="0.01"} 400
proof_coordinator_worker_request_duration_seconds_bucket{handler="claim",le="0.025"} 850
proof_coordinator_worker_request_duration_seconds_bucket{handler="claim",le="0.05"} 895
proof_coordinator_worker_request_duration_seconds_bucket{handler="claim",le="+Inf"} 900
proof_coordinator_worker_request_duration_seconds_sum{handler="claim"} 18
proof_coordinator_worker_request_duration_seconds_count{handler="claim"} 900
# HELP proof_coordinator_worker_fence_rejections_total Worker lease-fence rejections
# TYPE proof_coordinator_worker_fence_rejections_total counter
proof_coordinator_worker_fence_rejections_total{handler="heartbeat"} 4
# HELP proof_coordinator_terminal_wp_claim_failures_total Terminal WP claim failures
# TYPE proof_coordinator_terminal_wp_claim_failures_total counter
proof_coordinator_terminal_wp_claim_failures_total 1
# HELP proof_coordinator_local_upload_issuance_failures_total Upload capability issuance failures
# TYPE proof_coordinator_local_upload_issuance_failures_total counter
proof_coordinator_local_upload_issuance_failures_total 2
# HELP proof_coordinator_run_loop_ticks_total Proof-work run-loop outcomes
# TYPE proof_coordinator_run_loop_ticks_total counter
proof_coordinator_run_loop_ticks_total{outcome="processed",error_kind="none"} 120
proof_coordinator_run_loop_ticks_total{outcome="failure",error_kind="transport"} 3
# HELP proof_coordinator_run_loop_tick_duration_seconds Proof-work run-loop tick duration
# TYPE proof_coordinator_run_loop_tick_duration_seconds histogram
proof_coordinator_run_loop_tick_duration_seconds_bucket{outcome="processed",le="0.5"} 20
proof_coordinator_run_loop_tick_duration_seconds_bucket{outcome="processed",le="1"} 70
proof_coordinator_run_loop_tick_duration_seconds_bucket{outcome="processed",le="2.5"} 115
proof_coordinator_run_loop_tick_duration_seconds_bucket{outcome="processed",le="+Inf"} 120
proof_coordinator_run_loop_tick_duration_seconds_sum{outcome="processed"} 144
proof_coordinator_run_loop_tick_duration_seconds_count{outcome="processed"} 120
