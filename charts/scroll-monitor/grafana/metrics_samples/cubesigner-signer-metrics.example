cubesigner_signer_last_worker_cycle_timestamp_seconds 0

# HELP cubesigner_signer_policy_fallback_signs_total Signs that succeeded DESPITE a bad or unusable bridge proof: the attached Wasm policy emitted dogecoin_testnet_proof_failed and still returned Allow, so the sign succeeded on testnet anyway. Captured from the policy_eval_tree returned because the sign request sets explain:true. Distinct failure_code per sign: a policy attached at both role and key level yields two leaves with the same event and is counted once. CAVEAT: each policy stream is hard-capped at 1024 bytes, cut mid-line, with no marker and no length field, so a truncated stream is indistinguishable from a complete one; if any policy output ever writes ahead of the event line, the event can be pushed past the cap and the count silently under-reports.
# TYPE cubesigner_signer_policy_fallback_signs_total counter
cubesigner_signer_policy_fallback_signs_total{failure_code="policy_pins_invalid"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="pi_mismatch"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="resolver_unavailable"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="resolver_deadline"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="resolver_stream_reset"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="resolver_server_error"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="resolver_status_invalid"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="resolver_headers_invalid"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="proof_invalid"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="proof_verification_failed"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="proof_reference_invalid"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="proof_reference_size_mismatch"} 0
cubesigner_signer_policy_fallback_signs_total{failure_code="proof_reference_hash_mismatch"} 0

