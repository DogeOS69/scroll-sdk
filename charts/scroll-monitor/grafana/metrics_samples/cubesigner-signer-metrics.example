# HELP cubesigner_signer_build_info Signer gateway build identity; value is always 1. version is the release, git_sha the deployed commit (or "unknown").
# TYPE cubesigner_signer_build_info gauge
cubesigner_signer_build_info{version="0.3.0",git_sha="e2e0000"} 1

# HELP cubesigner_signer_ready Whether /ready currently returns 200 (1) or 503 (0). Read at scrape time from the same readiness predicate /ready uses.
# TYPE cubesigner_signer_ready gauge
cubesigner_signer_ready 0

# HELP cubesigner_signer_production_policy_ready Whether the production verifier-key policy posture is ready (1) or blocked (0).
# TYPE cubesigner_signer_production_policy_ready gauge
cubesigner_signer_production_policy_ready 0

