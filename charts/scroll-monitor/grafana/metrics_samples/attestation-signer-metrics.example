# Synthetic Prometheus exposition for dashboard development. Prometheus adds
# job and instance labels at scrape time. No production identities are present.
# HELP attestation_signer_ready Whether the signer is ready for the configured policy mode
# TYPE attestation_signer_ready gauge
attestation_signer_ready{mode="observe"} 1
# HELP attestation_signer_queue_rows Current durable queue rows by lifecycle status
# TYPE attestation_signer_queue_rows gauge
attestation_signer_queue_rows{status="received"} 2
attestation_signer_queue_rows{status="signed"} 1
attestation_signer_queue_rows{status="rejected_policy"} 0
# HELP attestation_signer_queue_oldest_age_seconds Age of the oldest durable queue row
# TYPE attestation_signer_queue_oldest_age_seconds gauge
attestation_signer_queue_oldest_age_seconds{status="received"} 12.5
attestation_signer_queue_oldest_age_seconds{status="signed"} 4.2
attestation_signer_queue_oldest_age_seconds{status="rejected_policy"} 0
# HELP attestation_signer_worker_last_success_timestamp_seconds Last successful worker tick timestamp
# TYPE attestation_signer_worker_last_success_timestamp_seconds gauge
attestation_signer_worker_last_success_timestamp_seconds 1788500000
# HELP attestation_signer_intake_requests_total Sign-request intake outcomes
# TYPE attestation_signer_intake_requests_total counter
attestation_signer_intake_requests_total{result="accepted",kind="none"} 120
# HELP attestation_signer_worker_ticks_total Worker tick outcomes
# TYPE attestation_signer_worker_ticks_total counter
attestation_signer_worker_ticks_total{result="success",kind="none"} 4500
# HELP attestation_signer_worker_rows_total Worker row-processing outcomes
# TYPE attestation_signer_worker_rows_total counter
attestation_signer_worker_rows_total{starting_status="received",result="success",kind="none"} 120
# HELP attestation_signer_worker_failures_total Worker failures by bounded kind and terminality
# TYPE attestation_signer_worker_failures_total counter
attestation_signer_worker_failures_total{kind="artifact_source",terminal="false"} 3
# HELP attestation_signer_policy_decisions_total Policy decisions by mode classification and reason code
# TYPE attestation_signer_policy_decisions_total counter
attestation_signer_policy_decisions_total{mode="observe",classification="observed",reason_code="advance_l2_nested_proof_invalid"} 4
# HELP attestation_signer_signing_attempts_total Signing attempts by result
# TYPE attestation_signer_signing_attempts_total counter
attestation_signer_signing_attempts_total{result="success"} 116
# HELP attestation_signer_tso_callbacks_total TSO callbacks by path and result
# TYPE attestation_signer_tso_callbacks_total counter
attestation_signer_tso_callbacks_total{path="signed",result="success"} 114
# HELP attestation_signer_release_outcomes_total Recovered signed-row release outcomes
# TYPE attestation_signer_release_outcomes_total counter
attestation_signer_release_outcomes_total{result="hold_temporary"} 2
# HELP attestation_signer_worker_tick_duration_seconds Worker tick duration
# TYPE attestation_signer_worker_tick_duration_seconds histogram
attestation_signer_worker_tick_duration_seconds_bucket{result="success",le="0.01"} 2000
attestation_signer_worker_tick_duration_seconds_bucket{result="success",le="0.025"} 4300
attestation_signer_worker_tick_duration_seconds_bucket{result="success",le="+Inf"} 4500
attestation_signer_worker_tick_duration_seconds_sum{result="success"} 54
attestation_signer_worker_tick_duration_seconds_count{result="success"} 4500
# HELP attestation_signer_queue_wait_seconds Queue wait duration
