{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "manager": {
      "type": "object",
      "properties": {
        "workerEnv": {
          "description": "Public remote worker environment; credentials and chart/Core-owned variables are reserved.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "DOGEOS_PROVER_WORKER_TOKEN",
                "DOGEOS_PROVER_WORKER_READY_FILE",
                "NVIDIA_DRIVER_CAPABILITIES",
                "DOGEOS_CAPACITY_MANAGER",
                "DOGEOS_CAPACITY_SPEC_SHA256",
                "DOGEOS_WORKER_ID",
                "DOGEOS_WORKER_SLOT",
                "DOGEOS_CAPACITY_PROFILE"
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "dstack": {
          "type": "object",
          "properties": {
            "fallbackFleet": {
              "type": "string",
              "pattern": "^$|^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
            }
          }
        }
      }
    },
    "initialization": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fleetAction": {
          "enum": [
            "create",
            "reuse"
          ]
        },
        "fleets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "nodes"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nodes": {
                "type": "object",
                "required": [
                  "min",
                  "target",
                  "max"
                ],
                "properties": {
                  "min": {
                    "type": "integer",
                    "const": 0
                  },
                  "target": {
                    "type": "integer",
                    "const": 0
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "provider": {
          "enum": [
            "",
            "aws",
            "vastai"
          ]
        },
        "fallbackProvider": {
          "enum": [
            "",
            "vastai"
          ]
        },
        "privateDns": {
          "type": "boolean"
        }
      }
    }
  }
}
