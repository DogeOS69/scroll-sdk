{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindings"],
  "properties": {
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetGroupARN", "serviceRef", "targetType"],
          "properties": {
            "targetGroupARN": {"type": "string", "pattern": "^arn:aws:elasticloadbalancing:[a-z0-9-]+:[0-9]{12}:targetgroup/[a-zA-Z0-9_-]+/[a-f0-9]{16}$"},
            "targetType": {"type": "string", "enum": ["ip"]},
            "serviceRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "port"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    }
  }
}
