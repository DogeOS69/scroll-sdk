{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["configMapName", "peers"],
  "properties": {
    "configMapName": {
      "type": "string", "minLength": 1, "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "peers": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(enode://|0x)?[0-9a-fA-F]{128}$"}
    }
  }
}
