{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["proofCoordinator"],
  "properties": {
    "proofCoordinator": {
      "type": "object",
      "required": ["config"],
      "properties": {
        "config": {
          "type": "object",
          "required": ["content", "existingConfigMap", "key", "required"],
          "properties": {
            "content": { "type": "string" },
            "existingConfigMap": { "type": "string" },
            "key": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
            "required": { "type": "boolean" }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "proof-coordinator is singleton-only: it holds work leases under a single coordinator_id and its artifact store / data PVC are ReadWriteOnce. Do not run multiple replicas."
        }
      }
    }
  }
}
